# =========================
# Backend
# =========================
NODE_ENV=development
PORT=4000
# Несколько origin через запятую (localhost и 127.0.0.1 — разные Origin у браузера)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true только за HTTPS; на http://localhost оставьте false
COOKIE_SECURE=false

# PostgreSQL (используется через Prisma)
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public

# Redis (используется BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=replace-me-with-strong-secret-access
JWT_REFRESH_SECRET=replace-me-with-strong-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web Push (VAPID)
# Сгенерируйте пару командой: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BCK6r6Xa3zV9VuYxN2iJEFEoQF1B8fJ_2cQbq4jPmW9GaB1xQz_BwQyNwZL4xY3K6E8kzZ4CqJgYfVfA-KqoRXk
VAPID_PRIVATE_KEY=eUkX0v5sJpv1qgZJ5lZDBOq6Rh3l-h2_Yt9vKQE5h2g
VAPID_SUBJECT=mailto:admin@atelier.local

