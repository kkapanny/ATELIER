VITE_VAPID_PUBLIC_KEY=BCK6r6Xa3zV9VuYxN2iJEFEoQF1B8fJ_2cQbq4jPmW9GaB1xQz_BwQyNwZL4xY3K6E8kzZ4CqJgYfVfA-KqoRXk
